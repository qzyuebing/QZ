
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.6.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'wan'
	option proto 'static'
	option ipaddr '192.168.1.11'
	option netmask '255.255.255.0'
	option gateway '192.168.1.1'
	option broadcast '192.168.1.255'
	list dns '202.102.128.68'
	list dns '192.168.1.1'
	list dns '219.146.1.66'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'

config globals 'globals'
	option packet_steering '1'

config interface 'Unicom_IPTV'
	option proto 'dhcp'
	option hostname '*'
	option defaultroute '0'
	option delegate '0'
	option device 'br-iptv'

config device
	option type 'bridge'
	option name 'br-iptv'
	list ports 'lan1'
	list ports 'lan2'
	option mtu '1500'
	option macaddr 'D4:EE:07:45:EF:B8'
	option igmpversion '2'

